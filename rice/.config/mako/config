font=JetBrainsMono Nerd Font 11
background-color=#120808cc
text-color=#f5e6d0
border-color=#d4af37
border-size=2
border-radius=12
padding=16,20
margin=12
width=420
height=200
icons=1
max-icon-size=48
default-timeout=5000
anchor=top-right
layer=overlay
max-visible=4
sort=-time
group-by=app-name
progress-color=over #b22222

[grouped]
format=<b>%s</b> (%g)\n%b

[urgency=low]
border-color=#7a5252
text-color=#c8a0a0
default-timeout=3000

[urgency=high]
border-color=#ff1a3c
background-color=#1a0508cc
default-timeout=0

[app-name=Spotify]
border-color=#f0c040

[app-name=Firefox]
border-color=#7fc8ff
