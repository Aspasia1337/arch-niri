# zathura - nightshade theme (dark, matches the arch-niri palette)

# Dark mode: invert page colors (light text on dark background).
# recolor-lightcolor = the page background, recolor-darkcolor = the text.
# reverse-video/keephue off so image-only (scanned) PDFs also get a dark background.
set recolor                true
set recolor-keephue        false
set recolor-reverse-video  false
set recolor-lightcolor     "#000000"
set recolor-darkcolor      "#e8dcc8"

# Window / default
set default-bg             "#000000"
set default-fg             "#e8dcc8"
set render-loading         true
set render-loading-bg      "#000000"
set render-loading-fg      "#e8dcc8"

# Status bar
set statusbar-bg           "#1a1423"
set statusbar-fg           "#e8dcc8"

# Input bar
set inputbar-bg            "#0d0a12"
set inputbar-fg            "#e8dcc8"

# Completion
set completion-bg          "#1a1423"
set completion-fg          "#e8dcc8"
set completion-group-bg    "#0d0a12"
set completion-group-fg    "#ff7518"
set completion-highlight-bg "#5b3a8c"
set completion-highlight-fg "#f5ecd9"

# Search / link highlight
set highlight-color        "#ff7518"
set highlight-active-color "#9b30ff"

# Notifications
set notification-bg         "#1a1423"
set notification-fg         "#e8dcc8"
set notification-error-bg   "#1a1423"
set notification-error-fg   "#ff1a3c"
set notification-warning-bg "#1a1423"
set notification-warning-fg "#ff7518"

# Misc
set adjust-open            "best-fit"
set selection-clipboard    clipboard
