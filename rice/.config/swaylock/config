# ~/.config/swaylock/config  (requires swaylock-effects)

image=/home/YOUR_USER/wallpapers/green.jpg
scaling=fill
color=0a1208
effect-scale=0.5
effect-blur=8x4
effect-scale=2
effect-vignette=0.3:0.95
fade-in=0.5

clock
indicator
indicator-idle-visible
timestr=%H:%M
datestr=%A %d %B
font=sans-serif:bold
font-size=56
indicator-radius=160
indicator-thickness=9
line-uses-ring
hide-keyboard-layout
indicator-caps-lock
disable-caps-lock-text

inside-color=0a120899
ring-color=8fd14fcc
key-hl-color=ff7518ff
bs-hl-color=ff1a3cff
separator-color=00000000
text-color=e8f5d0ff

inside-caps-lock-color=0a120899
ring-caps-lock-color=ff7518ff
text-caps-lock-color=ff9a4dff
caps-lock-key-hl-color=fff3c4ff
caps-lock-bs-hl-color=ff1a3cff

inside-ver-color=1a0f2699
ring-ver-color=9b30ffff
text-ver-color=d9b8ffff

inside-wrong-color=2a000899
ring-wrong-color=ff1a3cff
text-wrong-color=ff8a9aff

inside-clear-color=0a120899
ring-clear-color=7fc8ffff
text-clear-color=d6efffff

show-failed-attempts
ignore-empty-password
