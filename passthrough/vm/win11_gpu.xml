      <target type='serial' port='0'/>
    </console>
    <input type='mouse' bus='ps2'/>
    <input type='keyboard' bus='ps2'/>
    <tpm model='tpm-crb'>
      <backend type='emulator' version='2.0'/>
    </tpm>
    <audio id='1' type='none'/>
    <!-- Boot disk: a WHOLE physical NVMe drive passed through by PCIe (not a    -->
    <!-- qcow2/raw image). The guest sees a real disk with real SMART/identify  -->
    <!-- data, so there is no virtual-disk fingerprint. Because it is the actual -->
    <!-- physical drive, the same Windows install can also be booted directly on -->
    <!-- bare metal when needed. Replace 0x04:00.0 with YOUR drive's PCI addr.   -->
    <hostdev mode='subsystem' type='pci' managed='yes'>
      <source>
        <address domain='0x0000' bus='0x04' slot='0x00' function='0x0'/>
      </source>
      <boot order='1'/>
      <address type='pci' domain='0x0000' bus='0x05' slot='0x00' function='0x0'/>
    </hostdev>
    <!-- GPU: video function (Radeon RX 9070 XT) -->
    <hostdev mode='subsystem' type='pci' managed='yes'>
      <source>
        <address domain='0x0000' bus='0x0d' slot='0x00' function='0x0'/>
      </source>
      <address type='pci' domain='0x0000' bus='0x06' slot='0x00' function='0x0'/>
    </hostdev>
    <!-- GPU: HDMI/DP audio function -->
    <hostdev mode='subsystem' type='pci' managed='yes'>
      <source>
        <address domain='0x0000' bus='0x0d' slot='0x00' function='0x1'/>
      </source>
      <address type='pci' domain='0x0000' bus='0x07' slot='0x00' function='0x0'/>
    </hostdev>
    <!-- USB controller passed through for native peripherals -->
    <hostdev mode='subsystem' type='pci' managed='yes'>
      <source>
        <address domain='0x0000' bus='0x0f' slot='0x00' function='0x3'/>
      </source>
      <address type='pci' domain='0x0000' bus='0x08' slot='0x00' function='0x0'/>
    </hostdev>
    <watchdog model='itco' action='reset'/>
    <memballoon model='none'/>
  </devices>
  <qemu:commandline>
    <!-- SMBIOS spoofing: make the guest report the host's real board so it    -->
    <!-- looks like bare metal. Replace every placeholder below with YOUR       -->
    <!-- own hardware's values, read on the host with dmidecode (needs root):   -->
    <!--   sudo dmidecode -t 0   -> BIOS:  vendor, version, release date        -->
    <!--   sudo dmidecode -t 1   -> System: manufacturer, product, uuid, serial -->
    <!--   sudo dmidecode -t 2   -> Board:  manufacturer, product, version      -->
    <!--   sudo dmidecode -t 3   -> Chassis: manufacturer                       -->
    <!-- Match the guest's values to the host's exactly, including the type=1   -->
    <!-- uuid, so the spoofed firmware is internally consistent.                -->
    <qemu:arg value='-smbios'/>
    <qemu:arg value='type=0,vendor=&lt;BIOS_VENDOR&gt;,version=&lt;BIOS_VERSION&gt;,date=&lt;MM/DD/YYYY&gt;'/>
    <qemu:arg value='-smbios'/>
    <qemu:arg value='type=1,manufacturer=&lt;BOARD_VENDOR&gt;,product=&lt;BOARD_MODEL&gt;,version=&lt;REV&gt;,serial=Default string,family=&lt;FAMILY&gt;,uuid=00000000-0000-0000-0000-000000000000'/>
    <qemu:arg value='-smbios'/>
    <qemu:arg value='type=2,manufacturer=&lt;BOARD_VENDOR&gt;,product=&lt;BOARD_MODEL&gt;,version=Default string'/>
    <qemu:arg value='-smbios'/>
    <qemu:arg value='type=3,manufacturer=&lt;BOARD_VENDOR&gt;'/>
    <qemu:arg value='-machine'/>
    <qemu:arg value='x-oem-id=ALASKA,x-oem-table-id=A M I'/>
  </qemu:commandline>
