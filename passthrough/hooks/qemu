#!/bin/bash
# libvirt hook: rebind GPUs to the host after the passthrough VM shuts down.
#
# Dual GPU setup: both cards are handed to the VM automatically by libvirt
# (managed='yes' in <hostdev>). This hook handles the way back: on VM
# release it unbinds from vfio-pci and rebinds the host drivers.
#
# Install to: /etc/libvirt/hooks/qemu  (chmod +x)

[ "$1" = "YOUR_VM_NAME" ] || exit 0
[ "$2" = "release" ] && [ "$3" = "end" ] || exit 0
exec >> /var/log/libvirt/gpu-hook.log 2>&1
echo "== $(date) release =="

# Replace with your PCI addresses (lspci -nnk | grep -A3 VGA)
GPU1_VGA=0000:00:00.0
GPU1_HDA=0000:00:00.1

GPU2_VGA=0000:00:00.0
GPU2_HDA=0000:00:00.1

sleep 2

for dev in $GPU1_VGA $GPU1_HDA $GPU2_VGA $GPU2_HDA; do
    echo "$dev" > /sys/bus/pci/drivers/vfio-pci/unbind 2>/dev/null
    echo "" > /sys/bus/pci/devices/$dev/driver_override
done

sleep 1

modprobe amdgpu
echo "$GPU1_VGA" > /sys/bus/pci/drivers/amdgpu/bind
echo "$GPU2_VGA" > /sys/bus/pci/drivers/amdgpu/bind
sleep 3
echo "$GPU1_HDA" > /sys/bus/pci/drivers/snd_hda_intel/bind
echo "$GPU2_HDA" > /sys/bus/pci/drivers/snd_hda_intel/bind

for vt in /sys/class/vtconsole/vtcon*/bind; do echo 1 > "$vt"; done
